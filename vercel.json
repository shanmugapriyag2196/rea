{
  "version": 2,
  "installCommand": "npm install --prefix local-deploy-platform",
  "buildCommand": "echo \"vg-deploy static+api\"",
  "functions": {
    "api/[...path].js": {
      "includeFiles": "local-deploy-platform/**"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/[...path].js" }
  ]
}
