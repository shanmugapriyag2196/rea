{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "echo \"vg-deploy api\"",
  "functions": {
    "api/[...path].js": {
      "includeFiles": "{server.js,database.js,worker.js,integrations/**,public/**,node_modules/**}"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/[...path].js" }
  ]
}
