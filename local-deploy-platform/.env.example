# Local Deploy Platform — Environment Configuration
# This file is excluded from version control (.gitignore)
# DO NOT commit real secrets, API keys, or passwords to version control.

# Server configuration
PORT=3456
HOST=127.0.0.1

# Build worker limits
BUILD_TIMEOUT_MS=300000
BUILD_MAX_MEMORY_MB=512

# Deployment workspace
WORKSPACE_DIR=./workspaces
ARTIFACT_DIR=./public/deployments

# Log settings
LOG_DIR=./logs
